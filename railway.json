{
  "$schema": "https://railway.com/railway.schema.json",
  "build": { "builder": "DOCKERFILE", "dockerfilePath": "deploy/railway/Dockerfile" },
  "deploy": {
    "preDeployCommand": ["bun upstream/openrift/apps/api/src/modules/rifter/hosted-init.ts --catalog-if-empty"],
    "startCommand": "python3 deploy/railway/start.py",
    "healthcheckPath": "/api/health",
    "healthcheckTimeout": 180,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5,
    "numReplicas": 1
  }
}
